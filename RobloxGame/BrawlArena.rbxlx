			{ Pos = Vector3.new(16, 0, 18),   Color = Color3.fromRGB(220, 195, 155) },
			{ Pos = Vector3.new(-18, 0, 16),  Color = Color3.fromRGB(215, 188, 148) },
			{ Pos = Vector3.new(8, 0, 50),    Color = Color3.fromRGB(220, 195, 155) },
